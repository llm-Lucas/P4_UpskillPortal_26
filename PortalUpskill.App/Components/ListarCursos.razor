@page "/Cursos"

@inject ICursoData cursoData
@inject RefreshService refreshService
@inject IJSRuntime JS
@* Garantir que os serviços usados estão injetados (se já estiverem no _Imports.razor, podes apagar estas 3 linhas) *@
@inject NavigationManager navManager
@inject DialogService dialogService
@inject NotificationService notificationService

@using Radzen
@using System.Text

<PageTitle>Cursos - ISCTE Meta Digital</PageTitle>


<div class="cardstyle">
    <h2>Cursos</h2>

    <RadzenButton class="my-4" ButtonStyle="ButtonStyle.Primary" Text="Criar Curso" Icon="add" Click="@(() => navManager.NavigateTo("Curso"))" />

    @* Botão de Exportar para Excel *@
    <RadzenButton Text="Exportar para Excel" Icon="grid_on" Click="@ExportarExcel" style="margin-left: 10px;" />

    <RadzenGrid Data="@cursos"
                TItem="Curso"
                AllowSorting="true"
                AllowFiltering="true"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                AllowPaging="true"
                PageSize="10">
        <Columns>
            <RadzenGridColumn TItem="Curso" Property="Nome" Title="Nome" />
            <RadzenGridColumn TItem="Curso" Property="DuracaoHoras" Title="Duração em Horas" Sortable="false" Filterable="false" />
            <RadzenGridColumn TItem="Curso" Title="Candidaturas Abertas" Sortable="false" Filterable="false">
                <Template Context="Curso">
                    @if (Curso.CandidaturasAbertas)
                    {
                        <span style="color: #28a745; font-weight: bold;">Sim</span>
                    }
                    else
                    {
                        <span style="color: #dc3545;">Não</span>
                    }
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Curso" Title="Início Candidatura" Sortable="false" Filterable="false">
                <Template Context="Curso">
                    @(Curso.CandidaturasAbertas ? Curso.DataInicioCandidatura?.ToString("dd/MM/yyyy") ?? "—" : "—")
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Curso" Title="Fim Candidatura" Sortable="false" Filterable="false">
                <Template Context="Curso">
                    @(Curso.CandidaturasAbertas ? Curso.DataFimCandidatura?.ToString("dd/MM/yyyy") ?? "—" : "—")
                </Template>
            </RadzenGridColumn>

            @if (Mode == "Add")
            {
                <RadzenGridColumn TItem="Curso" Title="Adicionar" Sortable="false" Filterable="false">
                    <Template Context="Curso">
                        <RadzenButton Title="Adicionar Curso" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Secondary" Icon="add" Click="@(() => SendCurso(Curso.Id))" />
                    </Template>
                </RadzenGridColumn>
            }
            else
            {
                <RadzenGridColumn TItem="Curso" Title="Opções" Sortable="false" Filterable="false">
                    <Template Context="Curso">
                        <RadzenButton Title="Ver Detalhes" Size="ButtonSize.Medium" Icon="description" Click=@(args => dialogService.Open<DetalhesCurso>("Detalhes do curso",
                                                                                                                             new Dictionary<string, object>() { { "CursoId", Curso.Id } },
                                                                                                                             new DialogOptions() { Width = "80%", Height = "90%" })) />
                        <RadzenButton Title="Editar" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Secondary" Icon="mode_edit" Click="@(() => navManager.NavigateTo($"Curso/{Curso.Id}"))" />
                        <RadzenButton Title="Remover" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="@(() => ConfirmDelete(Curso))" />
                    </Template>
                </RadzenGridColumn>
            }
        </Columns>
    </RadzenGrid>
</div>

<div class="row justify-content-center">
    <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Voltar" Click="@(() => navManager.NavigateTo($"Index"))" />
    </div>
</div>
<br />

@code {

    List<Curso> cursos = new List<Curso>();

    [Parameter]
    public string Mode { get; set; }

    [Parameter]
    public EventCallback<int> OutgoingCurso { get; set; }

    protected override async Task OnInitializedAsync()
    {
        LoadCursos();
    }

    void LoadCursos()
    {
        // Proteção contra nulos caso a base de dados não retorne dados
        var dbCursos = cursoData.GetAll();
        if (dbCursos != null)
        {
            cursos = dbCursos.OrderBy(c => c.Nome).ToList();
        }
    }

    private async Task SendCurso(int ToSendId)
    {
        await OutgoingCurso.InvokeAsync(ToSendId);
    }

    async Task ConfirmDelete(Curso curso)
    {
        await dialogService.OpenAsync("Confimar apagar", ds =>
        @<div>
            <p>Tem a certeza que pretende apagar @curso.Nome?</p>
            <p class="mb1 text-danger">Esta acção é irreversível.</p>
            <div class="row">
                <div class="col-md-12 d-flex justify-content-center">
                    <RadzenButton class="w-150 mx-2" Text="Ok" Click="() => DeleteCursoAction(curso, ds)" />
                    <RadzenButton class="w-150 mx-2" Text="Cancel" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Secondary" />
                </div>
            </div>
        </div>);
    }

    void DeleteCursoAction(Curso curso, DialogService ds)
    {
        if (cursoData.RemoveWithReturn(curso.Id))
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Curso removido com sucesso", Duration = 2000 });
        }
        else
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Curso não foi removido", Detail = "Por favor confirme que não existem entidades associadas ao curso", Duration = 5000 });
        }
        ds.Close(true);
        LoadCursos();
    }

    // Método de Exportação Corrigido para Base64
    private async Task ExportarExcel()
    {
        if (cursos == null || !cursos.Any())
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Aviso", Detail = "Não existem dados para exportar.", Duration = 3000 });
            return;
        }

        var csv = new StringBuilder();

        // Adiciona o BOM diretamente na string (como fizemos nos Relatórios)
        csv.AppendLine("\uFEFF");
        csv.AppendLine("Nome;Duração em Horas");

        foreach (var curso in cursos)
        {
            // Substitui pontos e vírgulas nos nomes para não quebrar colunas no Excel
            string nomeTratado = curso.Nome?.Replace(";", ",") ?? "";
            csv.AppendLine($"{nomeTratado};{curso.DuracaoHoras}");
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());

        // Converter para Base64 antes de enviar para o JavaScript
        var base64 = Convert.ToBase64String(bytes);

        // Usar exatamente a mesma função JS que usamos nos Relatórios (já existe no teu _Host.cshtml)
        await JS.InvokeVoidAsync("downloadFileFromBase64", "Lista_Cursos.csv", base64);
    }
}