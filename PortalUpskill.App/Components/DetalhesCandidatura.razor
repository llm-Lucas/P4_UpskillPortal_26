@inject ICandidaturaData candidaturaData

<div class="cardstyle">
    @if (candidatura == null)
    {
        <p>A carregar...</p>
    }
    else
    {
        <h4>Dados Pessoais</h4>
        <table class="table table-borderless table-sm">
            <tr><td><b>Nome</b></td><td>@candidatura.Pessoa.Nome</td></tr>
            <tr><td><b>Email</b></td><td>@candidatura.Pessoa.Email</td></tr>
            <tr><td><b>Telemóvel</b></td><td>@candidatura.Pessoa.ContactoTelemovel</td></tr>
            <tr><td><b>NIF</b></td><td>@candidatura.Pessoa.NIF</td></tr>
            <tr><td><b>Data de Nascimento</b></td><td>@(candidatura.Pessoa.DataNascimento?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
        </table>

        <h4 class="mt-4">Candidatura</h4>
        <table class="table table-borderless table-sm">
            <tr><td><b>1ª Opção</b></td><td>@candidatura.PrimeiraOpcao.Nome</td></tr>
            <tr><td><b>2ª Opção</b></td><td>@(candidatura.SegundaOpcao?.Nome ?? "—")</td></tr>
            <tr><td><b>Observações</b></td><td>@(candidatura.Observacoes ?? "—")</td></tr>
            <tr><td><b>Estado</b></td><td>@candidatura.Estado.Nome</td></tr>
            <tr><td><b>Data de Submissão</b></td><td>@candidatura.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td></tr>
        </table>

        <div class="row justify-content-center mt-4">
            @if (candidatura.EstadoId == 2)
            {
                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="check" Text="Aprovar"
                              Click="@(() => ConfirmarAlteracaoEstado(3))" style="margin-right: 10px;" />
                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="close" Text="Reprovar"
                              Click="@(() => ConfirmarAlteracaoEstado(4))" style="margin-right: 10px;" />
            }
            @if (candidatura.EstadoId == 1)
            {
                
            }
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="close" Text="Fechar"
                          Click="@(() => dialogService.Close())" />
        </div>
    }
</div>

@code {
    [Parameter]
    public int CandidaturaId { get; set; }

    Candidatura candidatura;

    protected override async Task OnInitializedAsync()
    {
        candidatura = candidaturaData.GetById(CandidaturaId);
    }

    void AlterarEstado(int novoEstadoId)
    {
        candidaturaData.UpdateEstado(CandidaturaId, novoEstadoId);
        candidatura = candidaturaData.GetById(CandidaturaId);
        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Estado actualizado com sucesso.",
                Duration = 3000
            });
        StateHasChanged();
    }
    async Task ConfirmarAlteracaoEstado(int novoEstadoId)
    {
        string acao = novoEstadoId == 3 ? "aprovar" : "reprovar";

        await dialogService.OpenAsync("Confirmar", render =>
    @<div>
        <p>Tem a certeza que quer @acao a candidatura de @candidatura.Pessoa.Nome?</p>
        <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 1rem;">
            <RadzenButton ButtonStyle="@(novoEstadoId == 3 ? ButtonStyle.Success : ButtonStyle.Danger)"
                          Text="@(novoEstadoId == 3 ? "Aprovar" : "Reprovar")"
                          Click="@(() => { AlterarEstado(novoEstadoId); dialogService.Close(); })" />
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Cancelar"
                          Click="@(() => dialogService.Close())" />
        </div>
    </div>
    , new DialogOptions { Width = "400px", Height = "auto" });
    }
}