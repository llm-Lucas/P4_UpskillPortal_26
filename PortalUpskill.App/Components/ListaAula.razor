@page "/ListaAula/{Idf:int}/{Idt:int}"

@inject IAulaData AulaData
@inject ITurmaData TurmaData
@inject IFormadorData FormadorData
@inject IPessoaData PessoaData
@* Injeção do teu serviço existente *@
@inject PortalUpskill.App.Utils.FileManagerService FileManagerService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Turma @getTurmaAtual()</h2>
    @* Botão que ativa a exportação *@
    <RadzenButton Text="Exportar para Excel" Icon="grid_on" Click="@ExportarParaExcel" />
</div>

<div class="cardstyle">
    <RadzenGrid Data="@aulas" TItem="Aula" AllowSorting="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowPaging="true" PageSize="10">
        <Columns>
            <RadzenGridColumn TItem="Aula" Property="Sumario" Title="Sumário" />
            <RadzenGridColumn TItem="Aula" Property="HoraInicio" Title="Data">
                <Template Context="Aula">
                    <span>@Aula.HoraInicio.ToString("dd/MM/yyyy")</span>
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Aula" Property="DuracaoHoras" Title="Duração (Horas)" />
            <RadzenGridColumn TItem="Aula" Title="Detalhes" Sortable="false" Filterable="false">
                <Template Context="Aula">
                    <RadzenButton Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Secondary" Title="Ver/Editar detalhes" Icon="mode_edit" Click="@(() => navManager.NavigateTo($"/DetalhesAula/{Aula.Id}/{Idf}/{Idt}/ListaAula"))" />
                </Template>
            </RadzenGridColumn>
        </Columns>
    </RadzenGrid>
</div>

@code {
    AulaViewModel aulaVM = new AulaViewModel();
    List<Aula> aulas = new List<Aula>();
    string turmaAtual = "";
    [Parameter] public int Idf { get; set; }
    [Parameter] public int Idt { get; set; }

    protected override async Task OnInitializedAsync()
    {
        aulas = AulaData.GetByTurmaFormador(Idt, Idf);
    }

    public string getTurmaAtual()
    {
        var turma = TurmaData.GetById(Idt);
        if (turma != null) { turmaAtual = turma.Nome; }
        return turmaAtual;
    }

    // Cria o Excel e invoca o teu FileManagerService
    private async Task ExportarParaExcel()
    {
        if (aulas != null && aulas.Count > 0)
        {
            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Sumários");

            // Cabeçalhos
            worksheet.Cell(1, 1).Value = "Sumário";
            worksheet.Cell(1, 2).Value = "Data";
            worksheet.Cell(1, 3).Value = "Duração (Horas)";
            worksheet.Row(1).Style.Font.Bold = true;

            // Preenchimento das linhas
            int row = 2;
            foreach (var item in aulas)
            {
                worksheet.Cell(row, 1).Value = item.Sumario;
                worksheet.Cell(row, 2).Value = item.HoraInicio.ToString("dd/MM/yyyy");
                worksheet.Cell(row, 3).Value = item.DuracaoHoras;
                row++;
            }
            worksheet.Columns().AdjustToContents();

            // Utiliza o método nativo do teu ficheiro FileManagerService
            await FileManagerService.DownloadWorkbook(workbook, ".xlsx", $"Sumarios_Turma_{turmaAtual.Replace(" ", "_")}");
        }
    }
}