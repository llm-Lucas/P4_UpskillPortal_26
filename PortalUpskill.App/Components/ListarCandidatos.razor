@page "/Candidatos"
@attribute [Authorize(Roles = "Administrador, Secretariado, Coordenador")]
@inject ICandidaturaData candidaturaData
@inject FileManagerService fileManager
@inject ICursoData cursoData

<div class="cardstyle">
    <h2>Candidatos</h2>
    <div class="mb-3" style="display: flex; gap: 10px; align-items: center;">
        <RadzenDropDown @bind-Value="cursoSelecionadoId"
                        Data="@cursos"
                        TValue="int?"
                        ValueProperty="Id"
                        TextProperty="Nome"
                        Placeholder="Seleccione o curso para exportar"
                        Style="width: 300px;" />
        <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="download" Text="Exportar Aprovados"
                      Click="ExportarAprovados"
                      Disabled="@(cursoSelecionadoId == null)" />
    </div>
    <RadzenGrid Data="@candidaturas"
                TItem="Candidatura"
                AllowSorting="true"
                AllowFiltering="true"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                AllowPaging="true"
                PageSize="10">
        <Columns>
            <RadzenGridColumn TItem="Candidatura" Property="Pessoa.Nome" Title="Nome" />
            <RadzenGridColumn TItem="Candidatura" Property="Pessoa.Email" Title="Email" />
            <RadzenGridColumn TItem="Candidatura" Property="PrimeiraOpcao.Nome" Title="1ª Opção" />
            <RadzenGridColumn TItem="Candidatura" Property="SegundaOpcao.Nome" Title="2ª Opção">
                <Template Context="c">
                    @(c.SegundaOpcao?.Nome ?? "—")
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Candidatura" Property="Estado.Nome" Title="Estado">
                <Template Context="c">
                    <span>@c.Estado.Nome</span>
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Candidatura" Property="DataCriacao" Title="Data">
                <Template Context="c">
                    @c.DataCriacao.ToString("dd/MM/yyyy")
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Candidatura" Title="Acções" Sortable="false" Filterable="false">
                <Template Context="c">
                    <RadzenButton Title="Ver Detalhes"
                                  Size="ButtonSize.Medium"
                                  Icon="description"
                                  Click="@(() => AbrirDetalhesCandidatura(c.Id))" />

                    <RadzenButton Title="Avaliação"
                                  Size="ButtonSize.Medium"
                                  ButtonStyle="ButtonStyle.Info"
                                  Icon="assessment"
                                  Disabled="@(c.EstadoId != 5 && c.EstadoId != 3)"
                                  Click="@(() => AbrirAvaliacaoCandidato(c.Id))" />

                    <RadzenButton Title="Reprovar"
                                  Size="ButtonSize.Medium"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Icon="close"
                                  Disabled="@(c.EstadoId != 2 && c.EstadoId != 5)"
                                  Click="@(() => ConfirmarAlteracaoEstado(c, 4))" />

                    <RadzenButton Title="Reverter Estado"
                                  Size="ButtonSize.Medium"
                                  ButtonStyle="ButtonStyle.Warning"
                                  Icon="undo"
                                  Disabled="@(!PodeReverter(c.EstadoId))"
                                  Click="@(() => ConfirmarReverterEstado(c))" />
                </Template>
            </RadzenGridColumn>
        </Columns>
    </RadzenGrid>
</div>

<div class="row justify-content-center">
    <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Text="Voltar"
                      Click="@(() => navManager.NavigateTo("Index"))" />
    </div>
</div>

@code {
    List<Candidatura> candidaturas = new List<Candidatura>();

    protected override async Task OnInitializedAsync()
    {
        LoadCandidaturas();
        cursos = cursoData.GetAll();

    }

    void LoadCandidaturas()
    {
        candidaturas = candidaturaData.GetAll();
    }
    async Task AbrirDetalhesCandidatura(int candidaturaId)
    {
        var result = await dialogService.OpenAsync<DetalhesCandidatura>(
            "Detalhes da Candidatura",
            new Dictionary<string, object>() { { "CandidaturaId", candidaturaId } },
            new DialogOptions() { Width = "70%", Height = "80%" });

        LoadCandidaturas();

        await InvokeAsync(StateHasChanged);
    }

    async Task AbrirAvaliacaoCandidato(int candidaturaId)
    {
        var result = await dialogService.OpenAsync<AvaliacaoCandidato>(
            "Avaliação do Candidato",
            new Dictionary<string, object>() { { "CandidaturaId", candidaturaId } },
            new DialogOptions() { Width = "70%", Height = "85%" });

        LoadCandidaturas();

        await InvokeAsync(StateHasChanged);
    }
    void AlterarEstado(Candidatura candidatura, int novoEstadoId)
    {
        candidaturaData.UpdateEstado(candidatura.Id, novoEstadoId);

        if (novoEstadoId == 6)
            candidaturaData.UpdateEstado(candidatura.Id, 1);
        LoadCandidaturas();
        StateHasChanged();
        notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Estado actualizado com sucesso.",
                    Duration = 3000
                });
    }
    bool PodeReverter(int estadoId)
{
    return estadoId == 3 || estadoId == 4 || estadoId == 6;
}

int ObterEstadoReversao(int estadoId)
{
    if (estadoId == 3)
        return 5;

    if (estadoId == 4)
        return 2;

    if (estadoId == 6)
        return 2;

    return estadoId;
}

async Task ConfirmarReverterEstado(Candidatura candidatura)
{
    int estadoAnterior = ObterEstadoReversao(candidatura.EstadoId);

    await dialogService.OpenAsync("Confirmar Reversão", render =>
@<div>
    <p>Tem a certeza que pretende reverter o estado da candidatura de @candidatura.Pessoa.Nome?</p>

    <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 1rem;">
        <RadzenButton ButtonStyle="ButtonStyle.Warning"
                      Text="Reverter"
                      Click="@(() => { AlterarEstado(candidatura, estadoAnterior); dialogService.Close(); })" />

        <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                      Text="Cancelar"
                      Click="@(() => dialogService.Close())" />
    </div>
</div>,
    new DialogOptions { Width = "400px", Height = "auto" });
}
    async Task ConfirmarAlteracaoEstado(Candidatura candidatura, int novoEstadoId)
    {
        string acao = novoEstadoId switch
        {
            3 => "aprovar",
            4 => "reprovar",
            5 => "aceitar",
            6 => "não aceitar",
            _ => "alterar"
        };

        await dialogService.OpenAsync("Confirmar", render =>
    @<div>
        <p>Tem a certeza que quer @acao a candidatura de @candidatura.Pessoa.Nome?</p>
        <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 1rem;">
            <RadzenButton ButtonStyle="@(novoEstadoId == 3 || novoEstadoId == 5 ? ButtonStyle.Success : ButtonStyle.Danger)"
                          Text="@(novoEstadoId switch { 3 => "Aprovar", 4 => "Reprovar", 5 => "Aceitar", 6 => "Não Aceitar", _ => "Confirmar" })"
                          Click="@(() => { AlterarEstado(candidatura, novoEstadoId); dialogService.Close(); })" />
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="Cancelar"
                          Click="@(() => dialogService.Close())" />
        </div>
    </div>
    , new DialogOptions { Width = "400px", Height = "auto" });
    }
    List<Curso> cursos = new List<Curso>();
    int? cursoSelecionadoId;


    
    async Task ExportarAprovados()
    {
        if (cursoSelecionadoId == null) return;

        var aprovados = candidaturaData.GetAprovadosByCurso(cursoSelecionadoId.Value);

        if (!aprovados.Any())
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Não existem candidatos aprovados para o curso seleccionado.",
                    Duration = 3000
                });
            return;
        }

        var nomeCurso = cursos.FirstOrDefault(c => c.Id == cursoSelecionadoId)?.Nome ?? "Curso";
        await fileManager.ExportarCandidatosAprovados(aprovados, nomeCurso);
    }
}