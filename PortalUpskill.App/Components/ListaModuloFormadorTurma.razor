@page "/ModulosFormadorTurma/{Idf:int}/{Id:int}"

@inject IModuloData moduloData
@inject ITurmaData turmaData
@inject PortalUpskill.App.Utils.FileManagerService FileManagerService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Title @getTurmaAtual()</h1>
    <RadzenButton Text="Exportar para Excel" Icon="description" ButtonStyle="ButtonStyle.Success" Click="@ExportarParaExcel" />
</div>

<RadzenGrid Data="@modulos" TItem="Modulo" AllowSorting="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowPaging="true" PageSize="10">
</RadzenGrid>

@code {
    List<Modulo> modulos;
    string turmaAtual = "";
    [Parameter] public string Title { get; set; } = "Módulos da Turma ";
    [Parameter] public int Idf { get; set; }
    [Parameter] public int Id { get; set; }

    protected override async Task OnInitializedAsync() { LoadModulos(); }
    void LoadModulos() { modulos = moduloData.GetByIdFormadorIdTurma(Idf, Id); }

    public string getTurmaAtual()
    {
        var turma = turmaData.GetById(Id);
        if (turma != null) { turmaAtual = turma.Nome; }
        return turmaAtual;
    }

    private async Task ExportarParaExcel()
    {
        if (modulos != null && modulos.Count > 0)
        {
            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Módulos");

            worksheet.Cell(1, 1).Value = "Nome do Módulo";
            worksheet.Cell(1, 2).Value = "Duração em Horas";
            worksheet.Row(1).Style.Font.Bold = true;

            int row = 2;
            foreach (var item in modulos)
            {
                worksheet.Cell(row, 1).Value = item.Nome;
                worksheet.Cell(row, 2).Value = item.Horas;
                row++;
            }
            worksheet.Columns().AdjustToContents();

            await FileManagerService.DownloadWorkbook(workbook, ".xlsx", $"Modulos_Turma_{turmaAtual.Replace(" ", "_")}");
        }
    }
}