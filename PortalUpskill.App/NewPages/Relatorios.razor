@page "/Relatorios"
@page "/Relatorios/{Id:int}"

@inject ITurmaData turmaData
@inject ICursoData cursoData
@inject IAulaData aulaData
@inject IFaltaData faltaData
@inject IFormadorData formadorData
@inject IFormandoData formandoData
@inject IPessoaData pessoaData
@inject IModuloData moduloData
@inject IPessoalData pessoalData
@inject NavigationManager navManager
@inject IJSRuntime JS

@using Radzen
@using System.Text

<PageTitle> Relatórios - ISCTE Meta Digital</PageTitle>


<div class="cardstyle">

    @* PASSO 1: Seleção da Turma *@
    @if (SelectedTurmaId == 0)
    {
        <h2>Relatórios</h2>
        <p class="text-muted">Por favor, selecione a turma que pretende consultar para aceder aos relatórios.</p>

        <div class="mt-4 mb-4">
            <label class="fw-bold mb-2 d-block">Turma</label>
            @* FIX: Alterado o Change para expressão lambda segura *@
            <RadzenDropDown class="w-50 d-block"
                            Data="@turmas"
                            @bind-Value="SelectedTurmaId"
                            Change="@(args => OnTurmaSelected())"
                            TValue="int"
                            ValueProperty="Id"
                            TextProperty="Nome"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            AllowClear="false">
                <Template Context="Turma">
                    <span>@Turma.Nome - @(Turma.Curso?.Nome ?? "Sem Curso")</span>
                </Template>
            </RadzenDropDown>
        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Text="Voltar" Click="@(() => navManager.NavigateTo("Index"))" />
            </div>
        </div>
    }
    @* PASSO 2: Seleção do Tipo de Relatório *@
    else if (SelectedRelatorio == 0)
    {
        <h2>Relatórios - @SelectedTurma?.Nome</h2>
        <p class="text-muted">Selecione o tipo de relatório que pretende consultar para esta turma.</p>

        <div class="row mt-4 justify-content-center">
            <div class="col-md-4 text-center d-flex justify-content-center">
                <a class="corbotao hvr-underline-from-left c-pointer" @onclick="() => EscolherRelatorio(1)" role="button">
                    <span class="oi oi-people" style="font-size: 48px; margin-top: 5px;"></span>
                    <span class="texto-card">FALTAS</span>
                </a>
            </div>

            <div class="col-md-4 text-center d-flex justify-content-center">
                <a class="corbotao hvr-underline-from-right c-pointer" @onclick="() => EscolherRelatorio(2)" role="button">
                    <span class="oi oi-document" style="font-size: 48px; margin-top: 5px;"></span>
                    <span class="texto-card">SUMÁRIOS</span>
                </a>
            </div>
            <div class="col-md-4 text-center d-flex justify-content-center">
                <a class="corbotao hvr-underline-from-center c-pointer"
                   @onclick="@(() => navManager.NavigateTo($"/RelatorioInqueritos/{SelectedTurmaId}"))"
                   role="button">
                    <span class="oi oi-bar-chart" style="font-size: 48px; margin-top: 5px;"></span>
                    <span class="texto-card">INQUÉRITOS</span>
                </a>
            </div>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-md-12 text-center">
                <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="arrow_back" Text="Escolher Outra Turma" Click="VoltarAoInicio" />
            </div>
        </div>
    }
    @* PASSO 3: Visualização do Relatório *@
    else
    {
        <div class="mb-4 d-flex justify-content-between align-items-center bg-light p-3 rounded">
            <span class="fs-5 fw-bold text-dark">Turma Atual: <span class="text-primary">@SelectedTurma?.Nome</span></span>
        </div>

        @* SUBPÁGINA: FALTAS *@
        @if (SelectedRelatorio == 1)
        {
            <div class="mb-3 text-end">
                <RadzenButton Text="Exportar para Excel" Icon="grid_on" Click="@ExportarFaltasParaExcel" />
            </div>

            @* FIX: Nome da referência alterada para gridFaltas *@
            <RadzenGrid @ref="gridFaltas"
                        Data="@formandosDaTurma"
                        TItem="PortalUpskill.Data.Models.Formando"
                        AllowSorting="true"
                        AllowFiltering="false"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        AllowPaging="true"
                        PageSize="@pageSize"
                        ExpandMode="@DataGridExpandMode.Single">

                @* subgrid de detalhe das faltas *@
                <Template Context="formando">
                    @{
                        var faltas = faltasPorFormando.ContainsKey(formando.Id)
                                     ? faltasPorFormando[formando.Id]
                                     : new List<FaltaDisplay>();
                    }
                    @if (!faltas.Any())
                    {
                        <p class="text-muted ms-3 mt-2">Sem faltas registadas.</p>
                    }
                    else
                    {
                        <div class="ms-3 mt-2 mb-2">
                            <RadzenGrid Data="@faltas"
                                        TItem="FaltaDisplay"
                                        AllowPaging="true"
                                        PageSize="5"
                                        AllowSorting="true"
                                        Style="width:100%">
                                <Columns>
                                    <RadzenGridColumn TItem="FaltaDisplay" Property="Data" Title="Data" Width="140px">
                                        <Template Context="f">
                                            @f.Data.ToString("dd/MM/yyyy")
                                        </Template>
                                    </RadzenGridColumn>

                                    <RadzenGridColumn TItem="FaltaDisplay" Property="Tipo" Title="Tipo" Width="160px">
                                        <Template Context="f">
                                            <span style="color: @(f.Tipo == "Justificada" ? "green" : "red"); font-weight:600">
                                                @f.Tipo
                                            </span>
                                        </Template>
                                    </RadzenGridColumn>

                                    <RadzenGridColumn TItem="FaltaDisplay" Property="Duracao" Title="Duração (min)" Width="140px" />
                                </Columns>
                            </RadzenGrid>
                        </div>
                    }
                </Template>

                <Columns>
                    <RadzenGridColumn TItem="PortalUpskill.Data.Models.Formando" Property="Nome" Title="Nome do Formando" />

                    <RadzenGridColumn TItem="PortalUpskill.Data.Models.Formando" Title="Faltas Justificadas"
                                      Bubble="false" Filterable="false" Sortable="false"
                                      TextAlign="TextAlign.Center" Width="200px">
                        <Template Context="formando">
                            <span class="text-success fw-bold">@ObterContagemFaltas(formando.Id, true)</span>
                        </Template>
                    </RadzenGridColumn>

                    <RadzenGridColumn TItem="PortalUpskill.Data.Models.Formando" Title="Faltas Injustificadas"
                                      Bubble="false" Filterable="false" Sortable="false"
                                      TextAlign="TextAlign.Center" Width="200px">
                        <Template Context="formando">
                            <span class="text-danger fw-bold">@ObterContagemFaltas(formando.Id, false)</span>
                        </Template>
                    </RadzenGridColumn>
                </Columns>
            </RadzenGrid>

            <br />

            <AuthorizeView Roles="Administrador, Coordenador">
                <Authorized>
                    <div style="position: relative; display: inline-block;">

                        <RadzenButton Text="Validar Justificações"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Icon="assignment"
                                      Click="@(() => navManager.NavigateTo("/Admin/ValidarJustificacoes"))" />

                        @if (justificacoesPendentesCount > 0)
                        {
                            <span class="badge-pulse-notification">
                                @justificacoesPendentesCount
                            </span>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        }

        @* SUBPÁGINA: SUMÁRIOS *@
        @if (SelectedRelatorio == 2)
        {

            <div class="mt-4">
                <h4 class="mb-3"><span class="oi oi-document me-2 text-primary"></span> Relatório de Sumários da Turma</h4>

                <div style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                    <span>Itens por página:</span>
                    @* FIX: Verificação de nulo com o operador ?. antes de dar Reload *@
                    <RadzenDropDown @bind-Value="@pageSize"
                                    Data="@(new int[] { 10, 15, 20, 50 })"
                                    Change="@(() => gridSumarios?.Reload())"
                                    Style="width: 80px" />

                </div>
                <RadzenButton Text="Exportar para Excel" Icon="grid_on" Click="@ExportarSumariosParaExcel" />

                @* FIX: Nome da referência alterada para gridSumarios *@
                <RadzenGrid @ref="gridSumarios"
                            Data="@aulasDaTurma"
                            TItem="PortalUpskill.Data.Models.Aula"
                            AllowSorting="true"
                            AllowFiltering="false"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            AllowPaging="true"
                            PageSize="@pageSize">
                    <Columns>
                        <RadzenGridColumn TItem="PortalUpskill.Data.Models.Aula" Property="HoraInicio" Title="Data / Hora" Width="220px">
                            <Template Context="aula">
                                @aula.HoraInicio.ToString("dd/MM/yyyy HH:mm")
                            </Template>
                        </RadzenGridColumn>

                        <RadzenGridColumn TItem="PortalUpskill.Data.Models.Aula" Property="DuracaoHoras" Title="Duração" TextAlign="TextAlign.Center" Width="120px" Sortable="false">
                            <Template Context="aula">
                                @aula.DuracaoHoras h
                            </Template>
                        </RadzenGridColumn>

                        <RadzenGridColumn TItem="PortalUpskill.Data.Models.Aula" Property="Sumario" Title="Sumário" Sortable="false">
                            <Template Context="aula">
                                <span style="white-space: pre-line;">@aula.Sumario</span>
                            </Template>
                        </RadzenGridColumn>

                        <RadzenGridColumn TItem="PortalUpskill.Data.Models.Aula" Title="Ações" Width="140px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                            <Template Context="aula">
                                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small"
                                              Icon="info"
                                              Text="Ver Detalhes"
                                              Click="@(() => navManager.NavigateTo($"/DetalhesAula/{aula.Id}"))" />
                            </Template>
                        </RadzenGridColumn>
                    </Columns>
                </RadzenGrid>
            </div>
        }

        <div class="row justify-content-center">
            <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
                <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                              Icon="cancel"
                              style="display: inline-block; margin-left: 10px;"
                              Text="Voltar"
                              Click="VoltarParaSelecao" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int Idf { get; set; }
    [Parameter] public int Idt { get; set; }
    [Parameter] public string? source { get; set; }
    [Parameter] public Func<Pessoal, bool> Filter { get; set; }
    [Parameter] public int Tipo { get; set; }

    @* FIX: Renomeados para evitar conflitos de Letras *@
    RadzenGrid<Formando> gridFaltas;
    RadzenGrid<Aula> gridSumarios;
    int pageSize = 10;

    private int justificacoesPendentesCount = 0;

    List<Formando> formandos = new();
    List<Aula> tabelaSumrios = new();
    List<Modulo> modulos = new();
    List<Turma> turmas = new();

    private List<PortalUpskill.Data.Models.Formando> formandosDaTurma = new();
    private List<PortalUpskill.Data.Models.Aula> aulasDaTurma = new();

    private Dictionary<int, (int Justificadas, int Injustificadas)> resumoFaltas = new();
    private Dictionary<int, List<FaltaDisplay>> faltasPorFormando = new();

    public class FaltaDisplay
    {
        public DateTime Data { get; set; }
        public string Tipo { get; set; }
        public int Duracao { get; set; }
    }

    int SelectedModuloId;
    int SelectedTurmaId;
    int SelectedRelatorio;
    int SelectedMes;
    Turma SelectedTurma;

    List<Aula> aulas = new();
    Dictionary<int, double> HorasPorModulo = new();
    Dictionary<int, Formador> FormadoresTurma = new();
    bool changesMade = false;

    protected override async Task OnInitializedAsync()
    {
        turmas = turmaData.GetAll() ?? new List<Turma>();
        if (Id != 0)
        {
            SelectedTurmaId = Id;
            OnTurmaSelected();
        }
    }

    private void OnTurmaSelected()
    {
        if (SelectedTurmaId == 0) return;

        formandos = new();
        tabelaSumrios = new();
        SelectedMes = 0;
        SelectedModuloId = 0;

        SelectedTurma = turmas.FirstOrDefault(t => t.Id == SelectedTurmaId);
        if (SelectedTurma != null)
        {
            @* FIX: Código defensivo contra nulos nos relacionamentos da Turma *@
            if (SelectedTurma.CursoId.HasValue)
            {
                SelectedTurma.Curso = cursoData.GetById(SelectedTurma.CursoId.Value);
            }

            SelectedTurma.Modulos = moduloData.GetModulosComFormadorByTurma(SelectedTurmaId) ?? new List<Modulo>();
            modulos = moduloData.GetModulosComFormadorByTurma(SelectedTurmaId) ?? new List<Modulo>();

            var todasPendentes = faltaData.GetFaltasPendentes();
            if (todasPendentes != null)
            {
                justificacoesPendentesCount = todasPendentes.Count(f => f?.Aula?.TurmaId == SelectedTurmaId);
            }
            else
            {
                justificacoesPendentesCount = 0;
            }

            var result = moduloData.GetModuloFormadorByTurma(SelectedTurma);

            if (SelectedTurma.Curso?.Modulos != null && result != null)
            {
                foreach (var moduloHora in SelectedTurma.Curso.Modulos.ToList())
                {
                    @* FIX: Validação se a chave existe no dicionário retornado antes de atribuir *@
                    if (moduloHora.Key != null && result.ContainsKey(moduloHora.Key.Id) && result[moduloHora.Key.Id] != null)
                    {
                        SelectedTurma.Curso.Modulos[moduloHora.Key] = result[moduloHora.Key.Id].Horas;
                    }
                }
            }

            SelectedTurma.Aulas = aulaData.GetByTurma(SelectedTurma) ?? new List<Aula>();
        }
    }

    private void EscolherRelatorio(int tipo)
    {
        SelectedRelatorio = tipo;

        if (SelectedRelatorio == 1)
        {
            formandosDaTurma = formandoData.GetAllByTurma(SelectedTurmaId) ?? new List<Formando>();
            resumoFaltas.Clear();
            faltasPorFormando.Clear();

            foreach (var f in formandosDaTurma)
            {
                if (f == null) continue;

                var historicoFaltas = faltaData.GetByFormandoId(f.Id) ?? new List<Falta>();

                resumoFaltas[f.Id] = (
                    historicoFaltas.Count(x => x?.Justificada == true),
                    historicoFaltas.Count(x => x?.Justificada == false)
                );

                faltasPorFormando[f.Id] = historicoFaltas
                    .Where(x => x != null)
                    .OrderByDescending(x => x.HoraInicio)
                    .Select(x => new FaltaDisplay
                    {
                        Data = x.HoraInicio.Date,
                        Tipo = x.Justificada ? "Justificada" : "Injustificada",
                        Duracao = x.Duracao
                    }).ToList();
            }
        }
        else if (SelectedRelatorio == 2)
        {
            aulasDaTurma = aulaData.GetByTurma(SelectedTurmaId) ?? new List<Aula>();
        }

        StateHasChanged();
    }

    private int ObterContagemFaltas(int formandoId, bool buscarJustificadas)
    {
        if (resumoFaltas.TryGetValue(formandoId, out var contagem))
        {
            return buscarJustificadas ? contagem.Justificadas : contagem.Injustificadas;
        }
        return 0;
    }

    private void VoltarParaSelecao()
    {
        SelectedRelatorio = 0;
        StateHasChanged();
    }

    private void VoltarAoInicio()
    {
        SelectedRelatorio = 0;
        SelectedTurmaId = 0;
        SelectedTurma = null;
        formandosDaTurma = new();
        aulasDaTurma = new();
        resumoFaltas.Clear();
        faltasPorFormando.Clear();
        SelectedMes = 0;
        SelectedModuloId = 0;
    }

    private async Task ExportarFaltasParaExcel()
    {
        if (formandosDaTurma == null || !formandosDaTurma.Any()) return;

        var csv = new StringBuilder();
        csv.AppendLine("\uFEFF");
        csv.AppendLine("Nome do Formando;Faltas Justificadas;Faltas Injustificadas");

        foreach (var formando in formandosDaTurma)
        {
            if (formando == null) continue;
            var justificadas = ObterContagemFaltas(formando.Id, true);
            var injustificadas = ObterContagemFaltas(formando.Id, false);

            csv.AppendLine($"{formando.Nome};{justificadas};{injustificadas}");
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        string nomeFicheiro = $"Relatorio_Faltas_{SelectedTurma?.Nome ?? "Turma"}.csv";

        await TransferirFicheiro(nomeFicheiro, bytes);
    }

    private async Task ExportarSumariosParaExcel()
    {
        if (aulasDaTurma == null || !aulasDaTurma.Any()) return;

        var csv = new StringBuilder();
        csv.AppendLine("\uFEFF");
        csv.AppendLine("Data / Hora;Duração;Sumário");

        foreach (var aula in aulasDaTurma)
        {
            if (aula == null) continue;
            var sumarioLimpo = aula.Sumario?.Replace("\r", " ").Replace("\n", " ") ?? "";
            csv.AppendLine($"{aula.HoraInicio.ToString("dd/MM/yyyy HH:mm")};{aula.DuracaoHoras} h;{sumarioLimpo}");
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        string nomeFicheiro = $"Relatorio_Sumarios_{SelectedTurma?.Nome ?? "Turma"}.csv";

        await TransferirFicheiro(nomeFicheiro, bytes);
    }

    private async Task TransferirFicheiro(string nomeFicheiro, byte[] conteudo)
    {
        var base64 = Convert.ToBase64String(conteudo);
        await JS.InvokeVoidAsync("downloadFileFromBase64", nomeFicheiro, base64);
    }
}