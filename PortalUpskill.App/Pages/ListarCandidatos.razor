@page "/Candidatos"
@attribute [Authorize(Roles = "Administrador, Secretariado")]

@inject ICandidaturaData candidaturaData

<PageTitle>Candidatos - ISCTE Meta Digital</PageTitle>


<div class="cardstyle">
    <h2>Candidatos</h2>

    <RadzenGrid Data="@candidaturas"
                TItem="Candidatura"
                AllowSorting="true"
                AllowFiltering="true"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                AllowPaging="true"
                PageSize="10">
        <Columns>
            <RadzenGridColumn TItem="Candidatura" Property="Pessoa.Nome" Title="Nome" />
            <RadzenGridColumn TItem="Candidatura" Property="Pessoa.Email" Title="Email" />
            <RadzenGridColumn TItem="Candidatura" Property="PrimeiraOpcao.Nome" Title="1ª Opção" />
            <RadzenGridColumn TItem="Candidatura" Property="SegundaOpcao.Nome" Title="2ª Opção">
                <Template Context="c">
                    @(c.SegundaOpcao?.Nome ?? "—")
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Candidatura" Property="Estado.Nome" Title="Estado">
                <Template Context="c">
                    <span>@c.Estado.Nome</span>
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Candidatura" Property="DataCriacao" Title="Data">
                <Template Context="c">
                    @c.DataCriacao.ToString("dd/MM/yyyy")
                </Template>
            </RadzenGridColumn>
            <RadzenGridColumn TItem="Candidatura" Title="Acções" Sortable="false" Filterable="false">
                <Template Context="c">
                    <RadzenButton Title="Ver Detalhes" Size="ButtonSize.Medium" Icon="description"
                                  Click="@(() => dialogService.Open<DetalhesCandidatura>(
                            "Detalhes da Candidatura",
                            new Dictionary<string, object>() { { "CandidaturaId", c.Id } },
                            new DialogOptions() { Width = "70%", Height = "80%" }))" />
                    @if (c.EstadoId == 1 || c.EstadoId == 2)
                    {
                        <RadzenButton Title="Aprovar" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Success" Icon="check"
                                      Click="@(() => AlterarEstado(c, 3))" />
                        <RadzenButton Title="Reprovar" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Danger" Icon="close"
                                      Click="@(() => AlterarEstado(c, 4))" />
                    }
                    @if (c.EstadoId == 1)
                    {
                        <RadzenButton Title="Marcar em Análise" Size="ButtonSize.Medium" ButtonStyle="ButtonStyle.Warning" Icon="search"
                                      Click="@(() => AlterarEstado(c, 2))" />
                    }
                </Template>
            </RadzenGridColumn>
        </Columns>
    </RadzenGrid>
</div>

<div class="row justify-content-center">
    <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Text="Voltar" Click="@(() => navManager.NavigateTo("Index"))" />
    </div>
</div>

@code {
    List<Candidatura> candidaturas = new List<Candidatura>();

    protected override async Task OnInitializedAsync()
    {
        LoadCandidaturas();
    }

    void LoadCandidaturas()
    {
        candidaturas = candidaturaData.GetAll();
    }

    void AlterarEstado(Candidatura candidatura, int novoEstadoId)
    {
        candidaturaData.UpdateEstado(candidatura.Id, novoEstadoId);
        LoadCandidaturas();
        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Estado actualizado com sucesso.",
                Duration = 3000
            });
    }
}