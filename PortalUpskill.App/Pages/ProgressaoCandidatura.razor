@page "/ProgressaoCandidatura"
@attribute [Authorize(Roles = "Candidato")]
@inject ICandidaturaData candidaturaData
@inject IPessoaData pessoaData

<div class="cardstyle">

    <h2 style="font-size: 2rem; font-weight: bold; margin-bottom: 2rem;">Estado da Candidatura</h2>

    @if (candidatura == null)
    {
        <p>Não foi encontrada nenhuma candidatura associada à sua conta.</p>
    }
    else
    {
        <div style="text-align: center; margin-bottom: 2rem;">
            <span style="background: #007bff; color: white; padding: 0.75rem 1.5rem; border-radius: 25px; font-weight: bold; font-size: 1rem;">
                Estado Atual: @GetEstadoDescricao()
            </span>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">

            <!-- Fase 1 — Candidatura -->
            <div style="text-align: center; flex: 1; min-width: 150px;">
                <div style="width: 60px; height: 60px; border-radius: 8px; margin: 0 auto 0.5rem;
                     background: @(candidatura.EstadoId >= 1 ? "#28a745" : "#e0e0e0");
                     display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: white;">
                    @if (candidatura.EstadoId >= 1)
                    {
                        <span>✓</span>
                    }
                    else
                    {
                        <span>1</span>
                    }
                </div>
                <div style="color: #007bff; font-size: 0.8rem;">1ª Fase</div>
                <div style="font-weight: bold; color: #333;">Candidatura</div>
                <div style="margin-top: 1rem; text-align: left;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: @(candidatura.EstadoId >= 2 ? "#007bff" : "#aaa");">@(candidatura.EstadoId >= 2 ? "✔" : "○")</span>
                        <span style="font-size: 0.85rem; color: #333;">Submetida</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <span style="color: @(candidatura.EstadoId == 1 ? "#007bff" : "#aaa");">@(candidatura.EstadoId == 1 ? "✔" : "○")</span>
                        <span style="font-size: 0.85rem; color: #333;">Aguarda Submissão</span>
                    </div>

                </div>
            </div>

            <!-- Separador -->
            <div style="flex: 0; padding-top: 30px; color: #aaa;">▶</div>

            <!-- Fase 2 — Análise -->
            <div style="text-align: center; flex: 1; min-width: 150px;">
                <div style="width: 60px; height: 60px; border-radius: 8px; margin: 0 auto 0.5rem;
     background: @(candidatura.EstadoId == 2 || candidatura.EstadoId == 5 || candidatura.EstadoId == 3 || candidatura.EstadoId == 4 ? "#28a745" : "#e0e0e0");
     display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: white;">
                    
                    @if (candidatura.EstadoId == 2 || candidatura.EstadoId == 5 || candidatura.EstadoId == 3 || candidatura.EstadoId == 4)
                    {
                        <span>✓</span>
                    }
                    else
                    {
                        <span>2</span>
                    }
                </div>
                <div style="color: #007bff; font-size: 0.8rem;">2ª Fase</div>
                <div style="font-weight: bold; color: #333;">Análise</div>
                <div style="margin-top: 1rem; text-align: left;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: @(candidatura.EstadoId == 2 || candidatura.EstadoId == 5 || candidatura.EstadoId == 3 || candidatura.EstadoId == 4 ? "#007bff" : "#aaa");">
                            @(candidatura.EstadoId == 2 || candidatura.EstadoId == 5 || candidatura.EstadoId == 3 || candidatura.EstadoId == 4 ? "✔" : "○")
                        </span>
                        <span style="font-size: 0.85rem; color: #333;">Candidatura em Análise</span>
                    </div>
                </div>
            </div>

            <!-- Separador -->
            <div style="flex: 0; padding-top: 30px; color: #aaa;">▶</div>

            <!-- Fase 3 — Decisão Inicial -->
            <div style="text-align: center; flex: 1; min-width: 150px;">
                <div style="width: 60px; height: 60px; border-radius: 8px; margin: 0 auto 0.5rem;
    background: @(candidatura.EstadoId == 5 ? "#17a2b8" : candidatura.EstadoId == 3 || candidatura.EstadoId == 4 ? "#28a745" : candidatura.EstadoId == 6 ? "#dc3545" : "#e0e0e0");
     display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: white;">
           
                    @if (candidatura.EstadoId == 5 || candidatura.EstadoId == 3 || candidatura.EstadoId == 4)
                    {
                        <span>✓</span>
                    }
                    else if (candidatura.EstadoId == 6)
                    {
                        <span>✗</span>
                    }
                    else
                    {
                        <span>3</span>
                    }
                </div>
                <div style="color: #007bff; font-size: 0.8rem;">3ª Fase</div>
                <div style="font-weight: bold; color: #333;">Decisão Inicial</div>
                <div style="margin-top: 1rem; text-align: left;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <span style="color: @(candidatura.EstadoId == 5 || candidatura.EstadoId == 3 || candidatura.EstadoId == 4 ? "#17a2b8" : "#aaa");">
                            @(candidatura.EstadoId == 5 || candidatura.EstadoId == 3 || candidatura.EstadoId == 4 ? "✔" : "○")
                        </span>
                        <span style="font-size: 0.85rem; color: #333;">Candidatura Aceite</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: @(candidatura.EstadoId == 6 ? "#dc3545" : "#aaa");">
                            @(candidatura.EstadoId == 6 ? "✗" : "○")
                        </span>
                        <span style="font-size: 0.85rem; color: #333;">Candidatura Não Aceite</span>
                    </div>
                </div>
            </div>

            <!-- Separador -->
            <div style="flex: 0; padding-top: 30px; color: #aaa;">▶</div>

            <!-- Fase 4 — Avaliação -->
            <div style="text-align: center; flex: 1; min-width: 150px;">
                <div style="width: 60px; height: 60px; border-radius: 8px; margin: 0 auto 0.5rem;
                     background: @(candidatura.EstadoId == 3 ? "#28a745" : candidatura.EstadoId == 4 ? "#dc3545" : "#e0e0e0");
                     display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: white;">
                    @if (candidatura.EstadoId == 3)
                    {
                        <span>✓</span>
                    }
                    else if (candidatura.EstadoId == 4)
                    {
                        <span>✗</span>
                    }
                    else
                    {
                        <span>4</span>
                    }
                </div>
                <div style="color: #007bff; font-size: 0.8rem;">4ª Fase</div>
                <div style="font-weight: bold; color: #333;">Avaliação</div>
                <div style="margin-top: 1rem; text-align: left;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <span style="color: @(candidatura.EstadoId == 3 ? "#28a745" : "#aaa");">@(candidatura.EstadoId == 3 ? "✔" : "○")</span>
                        <span style="font-size: 0.85rem; color: #333;">Aprovado</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: @(candidatura.EstadoId == 4 ? "#dc3545" : "#aaa");">@(candidatura.EstadoId == 4 ? "✗" : "○")</span>
                        <span style="font-size: 0.85rem; color: #333;">Reprovado</span>
                    </div>
                </div>
            </div>

            <!-- Separador -->
            <div style="flex: 0; padding-top: 30px; color: #aaa;">▶</div>

            <!-- Fase 5 — Colocação -->
            <div style="text-align: center; flex: 1; min-width: 150px;">
                <div style="width: 60px; height: 60px; border-radius: 8px; margin: 0 auto 0.5rem;
                     background: @(estaEmTurma ? "#28a745" : "#e0e0e0");
                     display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: white;">
                    @if (estaEmTurma)
                    {
                        <span>✓</span>
                    }
                    else
                    {
                        <span>5</span>
                    }
                </div>
                <div style="color: #007bff; font-size: 0.8rem;">5ª Fase</div>
                <div style="font-weight: bold; color: #333;">Colocação</div>
                <div style="margin-top: 1rem; text-align: left;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: @(estaEmTurma ? "#28a745" : "#aaa");">@(estaEmTurma ? "✔" : "○")</span>
                        <span style="font-size: 0.85rem; color: #333;">Colocado em Turma</span>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top: 2rem; font-size: 0.85rem; color: #666;">
            <span style="color: #007bff;">✔</span> Consegue identificar o seu estado actual de candidatura através deste ícone.
        </div>
    }
</div>

<div class="row justify-content-center">
    <div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="arrow_back" Text="Voltar"
                      Click="@(() => navManager.NavigateTo("Index"))" />
    </div>
</div>

@code {
    Candidatura candidatura;
    Pessoa user;
    bool estaEmTurma = false;

    [CascadingParameter]
    Task<AuthenticationState> authStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await authStateTask;
        user = pessoaData.GetByEmail(auth.User.Identity.Name);

        var todas = candidaturaData.GetAll();
        candidatura = todas.FirstOrDefault(c => c.PessoaId == user.Id);

        estaEmTurma = user.PerfilId == 4;
    }

    string GetEstadoDescricao() => candidatura.EstadoId switch
    {
        1 => "Aguarda Submissão",
        2 => "Candidatura em Análise",
        3 => estaEmTurma ? "Aprovado e Colocado em Turma" : "Aprovado",
        4 => "Reprovado",
        5 => "Candidatura Aceite — Aguarda Avaliação",
        6 => "Candidatura Não Aceite",
        _ => "Desconhecido"
    };
}