@page "/TurmaAvaliacoes/{TurmaId:int}"

@inject IFormandoData formandoData
@inject IAvaliacaoModularData avaliacaoModularData
@inject IModuloData moduloData
@inject ITurmaData turmaData
@inject IPessoaData pessoaData
@inject IJSRuntime JSRuntime
@inject RefreshService refreshService
@inject FileManagerService FMS
@inject NavigationManager navManager

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using System.Text @* ADICIONADO: Necessário para usar StringBuilder e Encoding *@

<PageTitle>Avaliações Modulares - ISCTE Meta Digital</PageTitle>


<style>
	form .row {
		margin-bottom: 16px;
	}
</style>

<div class="cardstyle">
	<h2>Avaliações dos módulos da turma @turma?.Nome</h2>

	<h3>Selecione um módulo</h3>

	<RadzenDropDown Data="@modulos" @bind-Value="selectedModuloId"
					AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
					ValueProperty="Id" TextProperty="Nome" AllowClear="true" Change=@OnModuloSelected>
	</RadzenDropDown>
	@if (selectedModuloId != 0)
	{
		<div class="row mx-0" style="margin-bottom: 2rem;">
			<AuthorizeView Roles="Secretariado, Administrador, Coordenador">
				<Authorized>
					<RadzenFieldset class="col-md-4 d-flex justify-content-center" Text="Upload da Pauta de Avaliação">
						<div>
							<p><b>Selecione um ficheiro para importar a pauta</b></p>
							<InputFile OnChange="OnInputExcel" />
							<p style="margin-top: 1rem;">@msg</p>
							<p style="font-size: small"><i>@fileMsg2</i></p>
						</div>
					</RadzenFieldset>
				</Authorized>
			</AuthorizeView>
			<RadzenFieldset class="col-md-4 d-flex justify-content-center" Text="Download da Pauta de Avaliação">
				<div>
					<p><b>Download da pauta</b></p>
					<RadzenButton class="w-150 mx-2" Text="Download" ButtonStyle="ButtonStyle.Primary" Click="DownloadAvaliacao" Disabled="@string.IsNullOrEmpty(fileMsg1)" />
					<p style="margin-top: 1rem;">@fileMsg1</p>
				</div>
			</RadzenFieldset>

			<div style="display: flex; flex-direction: column;justify-content: space-between;margin-top: 11px;">
				<AuthorizeView Roles="Secretariado, Administrador, Coordenador">
					<Authorized>
						<div style="padding: 26px">
							 <RadzenButton Text="Exportar para Excel" Icon="grid_on" Click="DownloadTabela" />
						</div>
					</Authorized>
				</AuthorizeView>
				<AuthorizeView Roles="Secretariado, Administrador">
					<Authorized>
						<div style="padding: 26px">
						</div>
					</Authorized>
				</AuthorizeView>
			</div>
		</div>

		<SfGrid TValue="AvaliacaoLinha" DataSource="@avaliacoesLinhas" AllowPaging="true" Height="315" Toolbar="@(new List<string>() { "Edit", "Update", "Cancel" })">
			<GridEvents TValue="AvaliacaoLinha" OnActionComplete="@GuardarAvaliacaoLinha"></GridEvents>

			<GridEditSettings AllowEditing="true"
							  AllowAdding="false"
							  AllowDeleting="false"
							  Mode="EditMode.Dialog"
							  HeaderTemplate="@HeaderTemplate">
			</GridEditSettings>
			<GridColumns>
				<GridColumn Field="@nameof(AvaliacaoLinha.FormandoId)"
							HeaderText="Id"
							IsPrimaryKey="true"
							Visible="false">
				</GridColumn>

				<GridColumn Field="@nameof(AvaliacaoLinha.Nome)"
							HeaderText="Nome"
							IsPrimaryKey="true"
							AllowEditing="false"></GridColumn>

				<GridColumn Field="@nameof(AvaliacaoLinha.NotaFinal)"
							HeaderText="Nota Final do Módulo"
							EditType="EditType.NumericEdit"
							AllowEditing="true">
					<EditTemplate>
						@{
							var linha = (AvaliacaoLinha)context;
						}
						<SfNumericTextBox @bind-Value="linha.NotaFinal"
										  Min="0"
										  Max="20"
										  Decimals="2"
										  Format="n2" />
					</EditTemplate>
				</GridColumn>

				<GridColumn Field="@nameof(AvaliacaoLinha.Comentarios)"
							HeaderText="Comentários"
							EditType="EditType.DefaultEdit"
							AllowEditing="true">
				</GridColumn>
			</GridColumns>
		</SfGrid>
	}
</div>

<div class="row justify-content-center">
	<div class="col-md-12 d-flex align-items-end justify-content-center" style="margin-top: 16px;">
		<AuthorizeView Roles="Administrador, Secretariado">
			<Authorized>
				<RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Voltar" Click="@(() => navManager.NavigateTo($"Avaliacao"))" />
			</Authorized>
		</AuthorizeView>
		<AuthorizeView Roles="Coordenador">
			<Authorized>
				<RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Voltar" Click="@(() => navManager.NavigateTo($"Avaliacao"))" />
			</Authorized>
		</AuthorizeView>
		<AuthorizeView Roles="Formador">
			<Authorized>
				<RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Voltar" Click="@(() => navManager.NavigateTo($"AvaliacaoPorFormador"))" />
			</Authorized>
		</AuthorizeView>
	</div>
</div>
<br />

@code {
	void OnQueryCellClick() { }
	private bool editar;

	void CalcularEditarStatus()
	{
		editar = !(formandos.Any(f => f.DictAvaliacaoModular.ContainsKey(selectedModuloId)));
	}

	List<Modulo> modulos;
	List<Formando> formandos = new List<Formando>();
	List<AvaliacaoLinha> avaliacoesLinhas = new List<AvaliacaoLinha>();
	List<Formando> formandosNotaEstadoInicial;
	List<Formando> formandosNotasUpdate;
	List<Formando> formandosNotasCreate;
	Turma turma;

	[CascadingParameter]
	Task<AuthenticationState> authStateTask { get; set; }

	int selectedModuloId;
	int selectedCursoId;
	int formadorId;
	string fileMsg1 = "", fileMsg2 = "";

	[Parameter]
	public int TurmaId { get; set; }

	private string GetNotaFinalExpression()
	{
		return "";
	}

	protected override async Task OnInitializedAsync()
	{
		string user = (await authStateTask).User.Identity.Name;

		Pessoa pessoa = pessoaData.GetByEmail(user);

		if (pessoa.Perfil.Id == 3)
		{
			modulos = moduloData.GetModulosComFormadorByTurma(TurmaId).Where(m => m.Formador.Id == pessoa.Id).ToList();
		}
		else
		{
			modulos = moduloData.GetModulosComFormadorByTurma(TurmaId);
		}

		formandos = formandoData.GetAllByTurmaWithAvaliacao(TurmaId) ?? new List<Formando>();
		turma = turmaData.GetById(TurmaId) ?? new Turma();
		selectedCursoId = (int)(turma.CursoId ?? 0);
	}

	void CarregarAvaliacoesLinhas()
	{
		avaliacoesLinhas.Clear();

		foreach (var formando in formandos)
		{
			if (formando == null) continue;

			AvaliacaoLinha linha = new AvaliacaoLinha();
			linha.FormandoId = formando.Id;
			linha.Nome = formando.Nome;

			if (formando.DictAvaliacaoModular != null && formando.DictAvaliacaoModular.ContainsKey(selectedModuloId))
			{
				linha.NotaFinal = formando.DictAvaliacaoModular[selectedModuloId].NotaFinal;
				linha.Comentarios = formando.DictAvaliacaoModular[selectedModuloId].Comentarios;
			}
			else
			{
				linha.NotaFinal = 0;
				linha.Comentarios = "";
			}

			avaliacoesLinhas.Add(linha);
		}
	}

	async Task OnModuloSelected()
	{
		formandosNotaEstadoInicial = new List<Formando>(formandos.Count);
		formandos.ForEach(f => formandosNotaEstadoInicial.Add(new Formando(f)));
		if (modulos != null && modulos.Count() != 0 && selectedModuloId != 0)
		{
			var mod = modulos.FirstOrDefault(m => m.Id == selectedModuloId);
			if (mod != null && mod.Formador != null)
			{
				formadorId = mod.Formador.Id;
			}
		}
		fileMsg1 = ""; fileMsg2 = "";
		if (turma != null && FMS.FileExists(turma.Nome, selectedModuloId))
		{
			fileMsg1 = $"pauta_turma_{turma.Nome}_M{selectedModuloId}.xlsm";
			fileMsg2 = "Já existe uma pauta registada, caso queira atualizar selecione a nova pauta";
		}
		CalcularEditarStatus();
		CarregarAvaliacoesLinhas();
	}

	IBrowserFile selectedExcel;
	string msg = "", path;

	async void OnInputExcel(InputFileChangeEventArgs e)
	{
		selectedExcel = e.File;
		this.StateHasChanged();

		path = FMS.ExcelPath(selectedExcel, turma.Nome, selectedModuloId);
		if (path != "")
		{
			msg = "";
			await FMS.UploadFile(selectedExcel, path);
			ImportExcel();

			formandosNotasUpdate = new List<Formando>();
			formandosNotasCreate = new List<Formando>();
			foreach (var formando in formandos)
			{
				if (formando.DictAvaliacaoModular.Count != 0)
				{
					if (formandosNotaEstadoInicial.Single(f => f.Id == formando.Id).DictAvaliacaoModular.ContainsKey(selectedModuloId))
					{
						if (formando.DictAvaliacaoModular[selectedModuloId].NotaFinal != formandosNotaEstadoInicial.Single(f => f.Id == formando.Id).DictAvaliacaoModular[selectedModuloId].NotaFinal)
						{
							formandosNotasUpdate.Add(formando);
						}
					}
					else if (formando.DictAvaliacaoModular.ContainsKey(selectedModuloId) && formando.DictAvaliacaoModular[selectedModuloId].NotaFinal != 0)
					{
						formandosNotasCreate.Add(formando);
					}
				}
			}

			if (formandosNotasCreate.Count() > 0)
				formandoData.CreateAvaliacaoModular(formandosNotasCreate, selectedModuloId, formadorId);
			if (formandosNotasUpdate.Count() > 0)
				formandoData.UpdateAvaliacaoModular(formandosNotasUpdate, selectedModuloId);

			if (formandosNotasCreate.Count() > 0 || formandosNotasUpdate.Count() > 0)
				notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Operação efetuada com sucesso!", Duration = 4000 });
			else
				notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Ou as notas já estão em sistema ou o ficheiro está vazio.", Duration = 4000 });

			formandos = formandoData.GetAllByTurmaWithAvaliacao(TurmaId);
			fileMsg1 = $"pauta_turma_{turma.Nome}_M{selectedModuloId}.xlsm";
			StateHasChanged();
		}
		else
		{
			msg = "O ficheiro que seleccionou não é do tipo .xlsx/.xls/.xlsm";
		}
	}

	public void ImportExcel()
	{
		if (path != "")
		{
			using (XLWorkbook workbook = new XLWorkbook(path))
			{
				IXLWorksheet worksheet = workbook.Worksheet(1);

				var currentRow = worksheet.Row(9);
				while (!currentRow.Cell(2).IsEmpty())
				{
					string nome = currentRow.Cell(2).GetValue<string>();
					string[] nomeSplit = nome.Split(' ');

					foreach (var formando in formandos)
					{
						bool nomeIgual = false;
						bool match = false;
						do
						{
							for (int i = 0; i < nomeSplit.Length; i++)
							{
								if (formando.Nome.Contains(nomeSplit[i]))
								{
									nomeIgual = true;
									if (i == (nomeSplit.Length - 1))
									{
										if (currentRow.Cell(23).CachedValue.ToString() != "")
										{
											formando.DictAvaliacaoModular.Remove(selectedModuloId);
											formando.DictAvaliacaoModular.Add(selectedModuloId, new AvaliacaoModular() { NotaFinal = Convert.ToInt32(currentRow.Cell(23).CachedValue) });

											if (!currentRow.Cell(24).IsEmpty())
											{
												formando.DictAvaliacaoModular[selectedModuloId].Comentarios = currentRow.Cell(24).GetValue<string>();
											}
										}
										nomeIgual = false;
										match = true;
									}
								}
								else
								{
									nomeIgual = false;
									break;
								}
							}
						} while (nomeIgual == true);

						if (match == true) break;
					}

					currentRow = currentRow.RowBelow();
				}
			}
		}
	}

	async void DownloadAvaliacao()
	{
		string data = FMS.PathToBase64String(selectedModuloId, turma.Nome);
		if (data != "")
		{
			await JSRuntime.InvokeAsync<object>("saveAsFile", $"pauta_turma_{turma.Id}_M{selectedModuloId}.xlsm", data);
		}
		else
		{
			notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Não existe nenhum documento gravado em sistema!", Duration = 4000 });
		}
	}

	async Task ResetPauta()
	{
		// Espaço reservado para futura lógica
	}

	// NOVO: IMPLEMENTAÇÃO DO DOWNLOAD DA TABELA EM EXCEL (CSV)
	async Task DownloadTabela()
	{
		if (avaliacoesLinhas == null || !avaliacoesLinhas.Any())
		{
			notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Aviso", Detail = "Não existem dados para exportar.", Duration = 3000 });
			return;
		}

		var csv = new StringBuilder();

		// Inserção do BOM UTF-8 para garantir que nomes e a palavra "Comentários" mantenham os acentos legíveis no Excel
		csv.AppendLine("\uFEFF");
		csv.AppendLine("Nome;Nota Final do Módulo;Comentários");

		foreach (var linha in avaliacoesLinhas)
		{
			if (linha == null) continue;

			// Proteção ultra defensiva: Limpa quebras de linha e pontos-e-vírgulas digitados nos comentários
			string nomeLimpo = linha.Nome?.Replace(";", ",") ?? "";
			string comentariosLimpos = linha.Comentarios?.Replace(";", ",").Replace("\r", " ").Replace("\n", " ") ?? "";

			csv.AppendLine($"{nomeLimpo};{linha.NotaFinal.ToString("0.##")};{comentariosLimpos}");
		}

		var bytes = Encoding.UTF8.GetBytes(csv.ToString());
		var base64 = Convert.ToBase64String(bytes);

		// Obtém de forma amigável o nome do módulo selecionado para atribuir ao ficheiro
		var moduloAtual = modulos?.FirstOrDefault(m => m.Id == selectedModuloId);
		string nomeModuloFicheiro = moduloAtual != null ? moduloAtual.Nome : $"Modulo_{selectedModuloId}";

		// Remove caracteres proibidos em nomes de ficheiros do Windows/Linux por precaução
		nomeModuloFicheiro = string.Concat(nomeModuloFicheiro.Split(System.IO.Path.GetInvalidFileNameChars()));

		string nomeCompletoFicheiro = $"Avaliacoes_{turma?.Nome ?? "Turma"}_{nomeModuloFicheiro}.csv";

		// Dispara o download usando a infraestrutura Base64 existente
		await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", nomeCompletoFicheiro, base64);
	}

	RenderFragment<object> HeaderTemplate = (context) =>
	{
		var linha = context as AvaliacaoLinha;
		return builder =>
		{
			builder.AddContent(0, $"Avaliação de {linha?.Nome}");
		};
	};

	public class AvaliacaoLinha
	{
		public int FormandoId { get; set; }
		public string Nome { get; set; }
		public double NotaFinal { get; set; }
		public string Comentarios { get; set; }
	}

	void GuardarAvaliacaoLinha(Syncfusion.Blazor.Grids.ActionEventArgs<AvaliacaoLinha> args)
	{
		if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save)
		{
			AvaliacaoLinha linha = (AvaliacaoLinha)args.Data;
			Formando formando = formandos.FirstOrDefault(f => f.Id == linha.FormandoId);

			if (formando != null)
			{
				if (!formando.DictAvaliacaoModular.ContainsKey(selectedModuloId))
				{
					formando.DictAvaliacaoModular.Add(selectedModuloId, new AvaliacaoModular());
				}

				formando.DictAvaliacaoModular[selectedModuloId].NotaFinal = linha.NotaFinal;
				formando.DictAvaliacaoModular[selectedModuloId].Comentarios = linha.Comentarios;

				GravarAvaliacaoNaBD(linha);
			}
		}
	}

	void GravarAvaliacaoNaBD(AvaliacaoLinha linha)
	{
		Formando formando = formandos.FirstOrDefault(f => f.Id == linha.FormandoId);
		if (formando == null) return;

		if (!formando.DictAvaliacaoModular.ContainsKey(selectedModuloId))
		{
			formando.DictAvaliacaoModular.Add(selectedModuloId, new AvaliacaoModular());
		}

		formando.DictAvaliacaoModular[selectedModuloId].NotaFinal = linha.NotaFinal;
		formando.DictAvaliacaoModular[selectedModuloId].Comentarios = linha.Comentarios;

		List<Formando> lista = new List<Formando>();
		lista.Add(formando);

		if (formandosNotaEstadoInicial.Single(f => f.Id == formando.Id).DictAvaliacaoModular.ContainsKey(selectedModuloId))
		{
			formandoData.UpdateAvaliacaoModular(lista, selectedModuloId);
		}
		else
		{
			formandoData.CreateAvaliacaoModular(lista, selectedModuloId, formadorId);
		}

		notificationService.Notify(new NotificationMessage
		{
			Severity = NotificationSeverity.Success,
			Summary = "Avaliação gravada com sucesso.",
			Duration = 3000
		});
	}
}