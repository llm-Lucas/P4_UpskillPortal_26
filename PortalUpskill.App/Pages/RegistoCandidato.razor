    async Task GuardarEdicao()
    {
        if (vmEditar.PrimeiraOpcaoId == null)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "A 1ª opção de curso é obrigatória.",
                    Duration = 3000
                });
            return;
        }

        if (vmEditar.SegundaOpcaoId != null && vmEditar.SegundaOpcaoId == vmEditar.PrimeiraOpcaoId)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "A 1ª e 2ª opção não podem ser iguais.",
                    Duration = 3000
                });
            return;
        }
        // Guardar dados pessoais — preservar PerfilId e Funcao
        user.Nome = vmDados.Nome;
        user.Email = vmDados.Email;
        user.NIF = vmDados.NIF;
        user.CC = vmDados.CC;
        user.ContactoTelemovel = vmDados.Telemovel;
        user.DataNascimento = vmDados.DataNascimento;
        user.Sexo = vmDados.Sexo;
        user.Morada = vmDados.Morada;
        user.CP = vmDados.CP;
        user.Nacionalidade = vmDados.Nacionalidade;
        user.HabilitacoesLiterarias = vmDados.HabilitacoesLiterarias ?? 0;
        // Preservar campos críticos que não são editáveis aqui
        user.PerfilId = user.PerfilId;
        user.Funcao = user.Funcao;
        user.PerfilId = perfilIdOriginal;
        user.Funcao = funcaoOriginal;
        pessoaData.Update(user);


        // Guardar situação profissional na candidatura
        candidaturaData.UpdateSituacaoProfissional(candidatura.Id, vmDados.SituacaoProfissional);

        candidaturaData.Update(candidatura.Id, vmEditar.PrimeiraOpcaoId.Value, vmEditar.SegundaOpcaoId, vmEditar.Observacoes,
            caminhoFoto ?? candidatura.Foto,
            caminhoCv ?? candidatura.CV,
            caminhoCert ?? candidatura.CertificadoHabilitacoes,
            caminhoCCFrente ?? candidatura.CCFrente,
            caminhoCCVerso ?? candidatura.CCVerso);

        // Volta ao estado Aguarda Submissão
        candidaturaData.UpdateEstado(candidatura.Id, 1);

        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Candidatura actualizada. Não se esqueça de submeter novamente.",
                Duration = 4000
            });

        var todas = candidaturaData.GetAll();
        candidatura = todas.FirstOrDefault(c => c.PessoaId == user.Id);
        // Recarregar user da BD para o modo de visualização reflectir as alterações
        user = pessoaData.GetByEmail(user.Email);
        perfilIdOriginal = user.PerfilId;
        funcaoOriginal = user.Funcao;
        modoEditar = false;
        StateHasChanged();
    }

    string GetEstadoCor(int estadoId) => estadoId switch
    {
        1 => "#aaa",
        2 => "#f0a500",
        3 => "#28a745",
        4 => "#dc3545",
        _ => "#aaa"
    };

