@page "/Candidatura"

@inject IPessoaData pessoaData
@inject ICandidaturaData candidaturaData
@inject ICursoData cursoData
@inject IHabilitacoesData habilitacoesData
@inject FileManagerService fileManager
@inject IPaisesData paisesData
@using System.ComponentModel.DataAnnotations

<div class="cardstyle" style="max-width: 800px; margin: 2rem auto;">

    @* ==================== MODO VER ==================== *@
    @if (modoVer && !modoEditar)
    {
        <h2>A Minha Candidatura</h2>

        @if (candidatura == null)
        {
            <p>Não foi encontrada nenhuma candidatura associada à sua conta.</p>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-12">
                    <h4>Estado da Candidatura</h4>
                    <span style="font-size: 1rem; padding: 0.5rem 1rem; background: @GetEstadoCor(candidatura.EstadoId); color: white; border-radius: 20px;">
                        @candidatura.Estado.Nome
                    </span>
                    <p class="mt-2 text-muted">Primeira candidatura submetida em @candidatura.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <h4>Dados Pessoais</h4>
            <table class="table table-borderless table-sm">
                <tr><td><b>Nome</b></td><td>@user.Nome</td></tr>
                <tr><td><b>Email</b></td><td>@user.Email</td></tr>
                <tr><td><b>NIF</b></td><td>@user.NIF</td></tr>
                <tr><td><b>Cartão de Cidadão</b></td><td>@user.CC</td></tr>
                <tr><td><b>Telemóvel</b></td><td>@user.ContactoTelemovel</td></tr>
                <tr><td><b>Data de Nascimento</b></td><td>@(user.DataNascimento?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                <tr><td><b>Género</b></td><td>@(user.Sexo ?? "—")</td></tr>
                <tr><td><b>Morada</b></td><td>@(user.Morada ?? "—")</td></tr>
                <tr><td><b>Código Postal</b></td><td>@(user.CP ?? "—")</td></tr>
                <tr><td><b>Nacionalidade</b></td><td>@(user.Nacionalidade ?? "—")</td></tr>
                <tr><td><b>Qualificações Académicas</b></td><td>@(habilitacoes.FirstOrDefault(h => h.Codigo == user.HabilitacoesLiterarias)?.HabilitacoesLiterarias ?? "—")</td></tr>
                <tr><td><b>Situação Profissional</b></td><td>@(candidatura.SituacaoProfissional ?? "—")</td></tr>
            </table>

            <h4 class="mt-4">Opções de Curso</h4>
            <table class="table table-borderless table-sm">
                <tr><td><b>1ª Opção</b></td><td>@candidatura.PrimeiraOpcao.Nome</td></tr>
                <tr><td><b>2ª Opção</b></td><td>@(candidatura.SegundaOpcao?.Nome ?? "—")</td></tr>
            </table>

            <h4 class="mt-4">Motivação</h4>
            <p>@(candidatura.Observacoes ?? "—")</p>

            <h4 class="mt-4">Documentos Submetidos</h4>
            <table class="table table-borderless table-sm">
                <tr><td><b>Foto</b></td><td>@(candidatura.Foto != null ? "✓ Submetido" : "Não submetido")</td></tr>
                <tr><td><b>CV</b></td><td>@(candidatura.CV != null ? "✓ Submetido" : "Não submetido")</td></tr>
                <tr><td><b>Certificado de Habilitações</b></td><td>@(candidatura.CertificadoHabilitacoes != null ? "✓ Submetido" : "Não submetido")</td></tr>
                <tr><td><b>CC Frente</b></td><td>@(candidatura.CCFrente != null ? "✓ Submetido" : "Não submetido")</td></tr>
                <tr><td><b>CC Verso</b></td><td>@(candidatura.CCVerso != null ? "✓ Submetido" : "Não submetido")</td></tr>
            </table>

            @if (candidatura.EstadoId == 1 || candidatura.EstadoId == 2 || candidatura.EstadoId == 6)
            {
                <div class="mt-3" style="gap: 10px; display: flex;">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="edit" Text="Editar"
                                  Click="@(() => modoEditar = true)" />
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="send" Text="Submeter Candidatura"
                                  Click="SubmeterCandidatura2"
                                  Disabled="@(candidatura.EstadoId == 2)" />
                </div>
            }
        }

        <div class="row justify-content-center mt-4">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="arrow_back" Text="Voltar"
                          Click="@(() => navManager.NavigateTo("Index"))" />
        </div>
    }

    @* ==================== FORMULÁRIO UNIFICADO (REGISTO + EDIÇÃO) ==================== *@
    @if (!modoVer || modoEditar)
    {
        <h2>@(modoVer ? "Editar Candidatura" : "Submeter Candidatura")</h2>

        <p class="text-muted"><small>* Campos de preenchimento obrigatório.</small></p>

        @if (!modoVer && !cursosAbertos.Any())
        {
            <div class="alert alert-warning">
                <p><b>Não existem cursos com candidaturas abertas de momento.Consulte o site 
                    <a href="https://upskill.pt" target="_blank">upskill.pt</a> para mais informações.</b>

            </p>
                <p>Por favor tente mais tarde.</p>
            </div>
        }
        else
        {
            <EditForm Model="@vmForm" OnValidSubmit="GuardarFormulario">
                <DataAnnotationsValidator />

                @* ---- Dados Pessoais ---- *@
                <h4>Dados Pessoais</h4>

                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Nome Completo *" /></div>
                    <div class="col-md-8">
                        <RadzenTextBox class="form-control w-100" @bind-Value="vmForm.Nome" />
                        <ValidationMessage For="@(() => vmForm.Nome)" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Email *" /></div>
                    <div class="col-md-8">
                        <RadzenTextBox class="form-control w-100" @bind-Value="vmForm.Email" />
                        <ValidationMessage For="@(() => vmForm.Email)" />
                    </div>
                </div>

                @* Password só no registo *@
                @if (!modoVer)
                {
                    <div class="row form-group">
                        <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Password *" /></div>
                        <div class="col-md-8">
                            <RadzenPassword class="form-control w-100" @bind-Value="vmForm.Password" />
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Confirmar Password *" /></div>
                        <div class="col-md-8">
                            <RadzenPassword class="form-control w-100" @bind-Value="vmForm.ConfirmarPassword" />
                            <ValidationMessage For="@(() => vmForm.ConfirmarPassword)" />
                        </div>
                    </div>
                }

                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="NIF *" /></div>
                    <div class="col-md-8">
                        <RadzenTextBox class="form-control w-100" @bind-Value="vmForm.NIF" />
                        <ValidationMessage For="@(() => vmForm.NIF)" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Cartão de Cidadão *" /></div>
                    <div class="col-md-8">
                        <RadzenTextBox class="form-control w-100" @bind-Value="vmForm.CC" />
                        <ValidationMessage For="@(() => vmForm.CC)" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Telemóvel *" /></div>
                    <div class="col-md-8">
                        <RadzenTextBox class="form-control w-100" @bind-Value="vmForm.Telemovel" />
                        <ValidationMessage For="@(() => vmForm.Telemovel)" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Data de Nascimento *" /></div>
                    <div class="col-md-8">
                        <RadzenDatePicker class="w-100" DateFormat="dd/MM/yyyy" @bind-Value="vmForm.DataNascimento" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Género" /></div>
                    <div class="col-md-8">
                        <RadzenDropDown class="form-control w-100" @bind-Value="vmForm.Sexo"
                                        Data="@(new List<string> { "Masculino", "Feminino", "Outro", "Prefiro não indicar" })" TValue="string" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Morada *" /></div>
                    <div class="col-md-8">
                        <RadzenTextBox class="form-control w-100" @bind-Value="vmForm.Morada" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Código Postal *" /></div>
                    <div class="col-md-8">
                        <RadzenTextBox class="form-control w-100" @bind-Value="vmForm.CP" Placeholder="0000-000" />
                        <ValidationMessage For="@(() => vmForm.CP)" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Naturalidade" /></div>
                    <div class="col-md-8">
                        <RadzenDropDown class="form-control" @bind-Value="vmForm.Nacionalidade" Data="@paises"
                                        TValue="string" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        ValueProperty="iso" TextProperty="nome" AllowClear="true">
                            <Template Context="pais">
                                <span>@pais.iso - @pais.nome</span>
                            </Template>
                        </RadzenDropDown>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Qualificações Académicas" /></div>
                    <div class="col-md-8">
                        <RadzenDropDown class="form-control w-100" @bind-Value="vmForm.HabilitacoesLiterarias"
                                        Data="@habilitacoes" TValue="int?" ValueProperty="Codigo" TextProperty="HabilitacoesLiterarias" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Situação Profissional" /></div>
                    <div class="col-md-8">
                        <RadzenDropDown class="form-control w-100" @bind-Value="vmForm.SituacaoProfissional"
                                        Data="@(new List<string> { "Desempregado", "Empregado", "Estudante", "Outro" })" TValue="string" />
                    </div>
                </div>

                @* ---- Opções de Curso ---- *@
                <h4 class="mt-4">Opções de Curso</h4>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="1ª Opção de Curso *" /></div>
                    <div class="col-md-8">
                        <RadzenDropDown class="form-control w-100" @bind-Value="vmForm.PrimeiraOpcaoId"
                                        Data="@cursosAbertos" TValue="int?" ValueProperty="Id" TextProperty="Nome"
                                        Placeholder="Selecione o curso" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="2ª Opção de Curso" /></div>
                    <div class="col-md-8">
                        <RadzenDropDown class="form-control w-100" @bind-Value="vmForm.SegundaOpcaoId"
                                        Data="@cursosAbertos" TValue="int?" ValueProperty="Id" TextProperty="Nome"
                                        AllowClear="true" Placeholder="Opcional" />
                    </div>
                </div>

                @* ---- Motivação ---- *@
                <h4 class="mt-4">Motivação</h4>
                <div class="row form-group">
                    <div class="col-md-12">
                        <RadzenTextArea class="form-control w-100 mt-2" Rows="5" @bind-Value="vmForm.Observacoes" />
                    </div>
                </div>

                @* ---- Documentos ---- *@
                <h4 class="mt-4">@(modoVer ? "Actualizar Documentos" : "Documentos")</h4>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Foto" /></div>
                    <div class="col-md-8"><InputFile OnChange="@(e => CarregarFicheiro(e, "foto"))" accept="image/*" /></div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="CV" /></div>
                    <div class="col-md-8"><InputFile OnChange="@(e => CarregarFicheiro(e, "cv"))" accept=".pdf,.doc,.docx" /></div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="Certificado de Habilitações" /></div>
                    <div class="col-md-8"><InputFile OnChange="@(e => CarregarFicheiro(e, "cert"))" accept=".pdf,.jpg,.png" /></div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="CC Frente" /></div>
                    <div class="col-md-8"><InputFile OnChange="@(e => CarregarFicheiro(e, "ccfrente"))" accept="image/*,.pdf" /></div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 align-items-center d-flex"><RadzenLabel Text="CC Verso" /></div>
                    <div class="col-md-8"><InputFile OnChange="@(e => CarregarFicheiro(e, "ccverso"))" accept="image/*,.pdf" /></div>
                </div>

                @* Termos só no registo *@
                @if (!modoVer)
                {
                    <h4 class="mt-4">Termos e Condições</h4>
                    <div class="row form-group">
                        <div class="col-md-12 d-flex align-items-center" style="gap: 10px;">
                            <RadzenCheckBox @bind-Value="vmForm.TermosAceites" TValue="bool" />
                            <span>Concordo com os Termos e Condições e Política de Recolha e Tratamento de Dados Pessoais.</span>
                           
                        </div>
                    </div>
                }

                @* ---- Botões ---- *@
                <div class="row justify-content-center mt-4" style="gap: 10px;">
                    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success"
                                  Icon="save" Text="@(modoVer ? "Guardar Alterações" : "Guardar")" />
                    @if (modoVer)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Text="Cancelar"
                                      Click="@(() => modoEditar = false)" />
                    }
                    else
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="cancel" Text="Cancelar"
                                      Click="@(() => navManager.NavigateTo("/"))" />
                    }
                </div>

            </EditForm>
        }
    }

</div>

@code {

    #region Variáveis
    bool modoVer = false;
    bool modoEditar = false;
    int? perfilIdOriginal;
    string funcaoOriginal;

    Pessoa user;
    Candidatura candidatura;
    List<Curso> cursosAbertos = new List<Curso>();
    List<Habilitacoes> habilitacoes = new List<Habilitacoes>();
    List<Paises> paises = new List<Paises>();

    string caminhoFoto, caminhoCv, caminhoCert, caminhoCCFrente, caminhoCCVerso;

    CandidaturaFormViewModel vmForm = new CandidaturaFormViewModel();

    [CascadingParameter]
    Task<AuthenticationState> authStateTask { get; set; }
    #endregion

    #region Inicialização
    protected override async Task OnInitializedAsync()
    {
        var auth = await authStateTask;

        if (auth.User.Identity.IsAuthenticated)
        {
            user = pessoaData.GetByEmail(auth.User.Identity.Name);
            perfilIdOriginal = user.PerfilId;
            funcaoOriginal = user.Funcao;
            paises = paisesData.GetAll();
            habilitacoes = habilitacoesData.GetAll();
            var todas = candidaturaData.GetAll();
            candidatura = todas.FirstOrDefault(c => c.PessoaId == user.Id);
            modoVer = true;

            cursosAbertos = cursoData.GetAll().Where(c => c.CandidaturasAbertas).ToList();

            if (candidatura != null)
            {
                vmForm.PrimeiraOpcaoId = candidatura.PrimeiraOpcaoId;
                vmForm.SegundaOpcaoId = candidatura.SegundaOpcaoId;
                vmForm.Observacoes = candidatura.Observacoes;
            }

            vmForm = new CandidaturaFormViewModel
                {
                    Nome = user.Nome,
                    Email = user.Email,
                    NIF = user.NIF,
                    CC = user.CC,
                    Telemovel = user.ContactoTelemovel,
                    Morada = user.Morada,
                    CP = user.CP,
                    Nacionalidade = user.Nacionalidade,
                    Sexo = user.Sexo,
                    DataNascimento = user.DataNascimento,
                    HabilitacoesLiterarias = user.HabilitacoesLiterarias,
                    SituacaoProfissional = candidatura?.SituacaoProfissional,
                    PrimeiraOpcaoId = candidatura?.PrimeiraOpcaoId,
                    SegundaOpcaoId = candidatura?.SegundaOpcaoId,
                    Observacoes = candidatura?.Observacoes
                };
        }
        else
        {
            cursosAbertos = cursoData.GetAll().Where(c => c.CandidaturasAbertas).ToList();
            habilitacoes = habilitacoesData.GetAll();
            paises = paisesData.GetAll();
        }
    }
    #endregion

    #region Ficheiros
    async Task CarregarFicheiro(InputFileChangeEventArgs e, string tipo)
    {
        var ficheiro = e.File;
        if (ficheiro == null) return;
        var caminho = await fileManager.SaveFileCandidatura(ficheiro, tipo, user?.Id ?? 0);
        switch (tipo)
        {
            case "foto": caminhoFoto = caminho; break;
            case "cv": caminhoCv = caminho; break;
            case "cert": caminhoCert = caminho; break;
            case "ccfrente": caminhoCCFrente = caminho; break;
            case "ccverso": caminhoCCVerso = caminho; break;
        }
    }
    #endregion

    #region Guardar Formulário
    async Task GuardarFormulario()
    {
        if (modoVer)
            await GuardarEdicao();
        else
            await RegistarCandidato();
    }

    async Task RegistarCandidato()
    {
        if (string.IsNullOrWhiteSpace(vmForm.Nome) ||
            string.IsNullOrWhiteSpace(vmForm.Email) ||
            string.IsNullOrWhiteSpace(vmForm.Password) ||
            string.IsNullOrWhiteSpace(vmForm.NIF) ||
            vmForm.PrimeiraOpcaoId == null)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Por favor preencha todos os campos obrigatórios.",
                    Duration = 3000
                });
            return;
        }

        if (vmForm.Password != vmForm.ConfirmarPassword)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "As passwords não coincidem.",
                    Duration = 3000
                });
            return;
        }

        if (!vmForm.TermosAceites)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Deve aceitar os Termos e Condições.",
                    Duration = 3000
                });
            return;
        }

        var pessoaExistente = pessoaData.GetByEmail(vmForm.Email);
        if (pessoaExistente != null)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Já existe uma conta com este email.",
                    Duration = 3000
                });
            return;
        }

        var todasPessoas = pessoaData.GetAll();

        if (!string.IsNullOrWhiteSpace(vmForm.NIF) && todasPessoas.Any(p => p.NIF == vmForm.NIF))
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Já existe uma conta com este NIF.",
                    Duration = 3000
                });
            return;
        }

        if (!string.IsNullOrWhiteSpace(vmForm.CC) && todasPessoas.Any(p => p.CC == vmForm.CC))
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Já existe uma conta com este Cartão de Cidadão.",
                    Duration = 3000
                });
            return;
        }

        if (!string.IsNullOrWhiteSpace(vmForm.Telemovel) && todasPessoas.Any(p => p.ContactoTelemovel == vmForm.Telemovel))
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Já existe uma conta com este telemóvel.",
                    Duration = 3000
                });
            return;
        }


        Pessoa novaPessoa = new Pessoa
            {
                Nome = vmForm.Nome,
                Email = vmForm.Email,
                Password = vmForm.Password,
                NIF = vmForm.NIF,
                CC = vmForm.CC,
                ContactoTelemovel = vmForm.Telemovel,
                DataNascimento = vmForm.DataNascimento,
                Sexo = vmForm.Sexo,
                Morada = vmForm.Morada,
                CP = vmForm.CP,
                Nacionalidade = vmForm.Nacionalidade,
                HabilitacoesLiterarias = vmForm.HabilitacoesLiterarias ?? 0,
                PerfilId = 5
            };

        int pessoaId = pessoaData.CreateReturnId(novaPessoa);

        Candidatura novaCandidatura = new Candidatura
            {
                PessoaId = pessoaId,
                PrimeiraOpcaoId = vmForm.PrimeiraOpcaoId.Value,
                SegundaOpcaoId = vmForm.SegundaOpcaoId,
                Observacoes = vmForm.Observacoes,
                EstadoId = 1,
                Foto = caminhoFoto,
                CV = caminhoCv,
                CertificadoHabilitacoes = caminhoCert,
                CCFrente = caminhoCCFrente,
                CCVerso = caminhoCCVerso,
                SituacaoProfissional = vmForm.SituacaoProfissional,
                TermosAceites = vmForm.TermosAceites
            };

        candidaturaData.Create(novaCandidatura);

        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Candidatura submetida com sucesso!",
                Duration = 4000
            });

        navManager.NavigateTo("/");
    }

    async Task GuardarEdicao()
    {
        if (vmForm.PrimeiraOpcaoId == null)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "A 1ª opção de curso é obrigatória.",
                    Duration = 3000
                });
            return;
        }
        if (vmForm.SegundaOpcaoId != null && vmForm.SegundaOpcaoId == vmForm.PrimeiraOpcaoId)
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "A 1ª e 2ª opção não podem ser iguais.",
                    Duration = 3000
                });
            return;
        }

        // Verificações de duplicados ANTES de alterar o user
        var todasPessoas = pessoaData.GetAll().Where(p => p.Id != user.Id).ToList();

        if (vmForm.Email != user.Email)
        {
            var pessoaComEmail = pessoaData.GetByEmail(vmForm.Email);
            if (pessoaComEmail != null)
            {
                notificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Warning,
                        Summary = "Já existe uma conta com este email.",
                        Duration = 3000
                    });
                return;
            }
        }
        if (!string.IsNullOrWhiteSpace(vmForm.NIF) && todasPessoas.Any(p => p.NIF == vmForm.NIF))
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Já existe uma conta com este NIF.",
                    Duration = 3000
                });
            return;
        }
        if (!string.IsNullOrWhiteSpace(vmForm.CC) && todasPessoas.Any(p => p.CC == vmForm.CC))
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Já existe uma conta com este Cartão de Cidadão.",
                    Duration = 3000
                });
            return;
        }
        if (!string.IsNullOrWhiteSpace(vmForm.Telemovel) && todasPessoas.Any(p => p.ContactoTelemovel == vmForm.Telemovel))
        {
            notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Já existe uma conta com este telemóvel.",
                    Duration = 3000
                });
            return;
        }

        // Só agora atribui os valores ao user
        user.Nome = vmForm.Nome;
        user.Email = vmForm.Email;
        user.NIF = vmForm.NIF;
        user.CC = vmForm.CC;
        user.ContactoTelemovel = vmForm.Telemovel;
        user.DataNascimento = vmForm.DataNascimento;
        user.Sexo = vmForm.Sexo;
        user.Morada = vmForm.Morada;
        user.CP = vmForm.CP;
        user.Nacionalidade = vmForm.Nacionalidade;
        user.HabilitacoesLiterarias = vmForm.HabilitacoesLiterarias ?? 0;
        user.PerfilId = perfilIdOriginal;
        user.Funcao = funcaoOriginal;
        pessoaData.Update(user);

        candidaturaData.UpdateSituacaoProfissional(candidatura.Id, vmForm.SituacaoProfissional);
        candidaturaData.Update(candidatura.Id, vmForm.PrimeiraOpcaoId.Value, vmForm.SegundaOpcaoId, vmForm.Observacoes,
            caminhoFoto ?? candidatura.Foto,
            caminhoCv ?? candidatura.CV,
            caminhoCert ?? candidatura.CertificadoHabilitacoes,
            caminhoCCFrente ?? candidatura.CCFrente,
            caminhoCCVerso ?? candidatura.CCVerso);
        candidaturaData.UpdateEstado(candidatura.Id, 1);

        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Candidatura actualizada. Não se esqueça de submeter novamente.",
                Duration = 4000
            });

        var todas = candidaturaData.GetAll();
        candidatura = todas.FirstOrDefault(c => c.PessoaId == user.Id);
        user = pessoaData.GetByEmail(user.Email);
        perfilIdOriginal = user.PerfilId;
        funcaoOriginal = user.Funcao;
        modoEditar = false;
        StateHasChanged();
    }
    #endregion

    #region Submeter Candidatura
    void SubmeterCandidatura2()
    {
        candidaturaData.Submeter(candidatura.Id);
        var todas = candidaturaData.GetAll();
        candidatura = todas.FirstOrDefault(c => c.PessoaId == user.Id);
        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Candidatura submetida com sucesso!",
                Duration = 3000
            });
        StateHasChanged();
    }
    #endregion

    #region Utilitários
    string GetEstadoCor(int estadoId) => estadoId switch
    {
        1 => "#aaa",
        2 => "#f0a500",
        3 => "#28a745",
        4 => "#dc3545",
        5 => "#17a2b8",
        6 => "#dc3545",
        _ => "#aaa"
    };
